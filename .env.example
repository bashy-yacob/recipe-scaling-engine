# ============================================
# DATABASE
# ============================================

# Development (SQLite - local, file-based)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - recommended: Neon, Supabase, Railway)
# DATABASE_URL="postgresql://user:password@host:5432/recipes?schema=public"

# ============================================
# AUTHENTICATION (JWT)
# ============================================

# Secret key for JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ============================================
# SERVER CONFIGURATION
# ============================================

# Backend server port (Express)
PORT=3001

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"

# ============================================
# AI SERVICES (Optional - for recipe parsing)
# ============================================

# Groq API (recommended - fast & free tier available)
# Get key from: https://console.groq.com/
GROQ_API_KEY="gsk_your_groq_api_key_here"

# OpenAI (alternative)
# OPENAI_API_KEY="sk-your-openai-api-key"

# ============================================
# DEVELOPMENT
# ============================================

# Node environment
NODE_ENV="development"

# Enable debug logs
# DEBUG="prisma:*"
